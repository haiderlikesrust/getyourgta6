# Paste into the application's Environment tab in Dokploy, then fill in the blanks.
# Do not commit filled-in values. These are runtime variables: never put them in
# "Build-time Arguments". Every variable is explained in .env.example.

# ---------- Required ----------
# The coin's contract address. Shown on the site and used for the draw.
CA=
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=PASTE_HELIUS_KEY
# Treasury wallet (base58 secret). Dedicated wallet, a little SOL for fees.
REWARD_WALLET_SECRET=
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this one forever: it decrypts stored gift card codes.
ENCRYPTION_KEY=

# ---------- Fixed for this deployment ----------
# SQLite file on the "gta6fund-data" volume mounted at /data (docs/DOKPLOY.md, step 5)
DATABASE_URL=file:/data/prod.db
# The app runs its own 5-minute worker (claim + swap, then draw). No cron service needed.
WORKER_ENABLED=true
TEST_MODE=false

# ---------- The draw ----------
REWARD_THRESHOLD_USD=100
PRIZE_BUFFER_PERCENT=3
HOLDER_BOOST_PERCENT=0.1
HOLDER_BOOST_MULTIPLIER=10
HOLDERS_AUTO_ENTER=true
OPT_IN_MIN_SOL=0
EXCLUDE_ADDRESSES=
GIFT_CARD_BRANDS=playstation,xbox

# ---------- Creator rewards -> SOL ----------
REWARD_TOKEN_MINT=TTWofwAge91oFhZs7kpQdyrVRkmevgM88xijGvQFbKo
REWARD_TOKEN_SYMBOL=TTWO
# Only if the coin's creator wallet is not the treasury wallet
PUMP_CREATOR_WALLET_SECRET=
JUP_API_KEY=

# ---------- Gift cards (Bitrefill) ----------
# Start with "test"; switch to "live" after one full test claim.
BITREFILL_MODE=test
BITREFILL_API_KEY=
BITREFILL_PAYMENT_METHOD=solana
BITREFILL_PRODUCT_PLAYSTATION=
BITREFILL_PRODUCT_XBOX=

# ---------- Shown on the site ----------
TOKEN_SYMBOL=GTA6FUND
