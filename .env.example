# ---------- Core ----------
# Helius API key (holder snapshots use Helius' getTokenAccounts)
HELIUS_API_KEY=your_helius_api_key

# Your coin's contract address (the pump.fun mint). Shown on the site with a
# copy button and used for the holder snapshot. (The old name TOKEN_MINT still works.)
CA=

# Solana RPC URL (Helius mainnet recommended)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Base58 secret key of the treasury wallet. It receives the swapped creator
# rewards and pays for the gift cards. Use a dedicated wallet.
REWARD_WALLET_SECRET=your_reward_wallet_secret_base58

# Secret for the cron endpoints (send as "x-cron-secret" or "Authorization: Bearer")
CRON_SECRET=generate_a_long_random_secret

# 32-byte hex key (64 hex chars): encrypts gift card codes and signs opt-in challenges
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (Docker: persisted in the /data volume)
DATABASE_URL=file:/data/dev.db

# ---------- The draw ----------
# Face value of the gift card
REWARD_THRESHOLD_USD=100
# What the card really costs on top of face value (provider markup, price moves,
# network fees), in %. A draw fires when the pot holds face value + this buffer,
# i.e. enough to actually buy the card. Set it to match your provider's price.
PRIZE_BUFFER_PERCENT=3

# Hold at least this % of total supply to get boosted odds
HOLDER_BOOST_PERCENT=0.1
# Tickets a boosted holder gets (a free opt-in is always 1 ticket)
HOLDER_BOOST_MULTIPLIER=10
# true  = wallets above the line are entered automatically at every draw
# false = holders must also connect and sign once
HOLDERS_AUTO_ENTER=true
# Anti-sybil: free opt-ins holding less SOL than this are skipped at draw time
# (0 = off). 0.02 makes farming thousands of empty wallets expensive.
OPT_IN_MIN_SOL=0

# Wallets that can never win (team, LP, exchange), comma-separated.
# Program-owned accounts (bonding curve, pools) are excluded automatically.
EXCLUDE_ADDRESSES=

# Platforms a winner can pick: playstation,xbox (use just "playstation" for PSN only)
GIFT_CARD_BRANDS=playstation,xbox

# SOL a winner sends (and gets back) to prove wallet ownership when claiming
VERIFY_AMOUNT_SOL=0.01

# ---------- Creator rewards -> SOL (Jupiter) ----------
# Mint the creator rewards are paid in. Default: TTWO tokenized stock.
REWARD_TOKEN_MINT=TTWofwAge91oFhZs7kpQdyrVRkmevgM88xijGvQFbKo
REWARD_TOKEN_SYMBOL=TTWO
# Max slippage for the swap, in basis points (100 = 1%)
SWAP_SLIPPAGE_BPS=100
# Refuse a swap if Jupiter quotes more price impact than this (%)
SWAP_MAX_PRICE_IMPACT_PERCENT=3
# Leave dust below this USD value un-swapped
SWAP_MIN_USD=5
# SOL always kept in the treasury for network fees
FEE_RESERVE_SOL=0.02
# Optional Jupiter API key (portal.jup.ag) for higher rate limits
JUP_API_KEY=
JUP_SWAP_BASE_URL=https://api.jup.ag/swap/v1

# ---------- Pump.fun creator wallet ----------
# Creator pubkey override (auto-detected from the CA's bonding curve if unset)
PUMP_CREATOR_WALLET=
# Creator wallet secret for signing reward claims (only if creator != treasury wallet)
PUMP_CREATOR_WALLET_SECRET=
# Min SOL vault balance (lamports) before claiming SOL-denominated fees
PUMP_MIN_CLAIM_LAMPORTS=10000

# ---------- Gift cards: Bitrefill, paid on Solana ----------
# Personal API key: bitrefill.com > Account > Developers
BITREFILL_API_KEY=your_bitrefill_api_key
# Business API alternative (leave blank if using the personal key above)
BITREFILL_API_ID=
BITREFILL_API_SECRET=
# mock = fake codes, no API | test = free Bitrefill test product | live = real money
BITREFILL_MODE=test
# How live orders are paid, straight from the treasury wallet:
#   solana      = SOL (default, no extra swap)
#   usdc_solana = USDC on Solana (the SOL needed is swapped on Jupiter per order)
#   balance     = a pre-funded Bitrefill account balance
BITREFILL_PAYMENT_METHOD=solana
# Live product ids per platform (npx tsx --env-file=.env scripts/find-products.ts playstation)
BITREFILL_PRODUCT_PLAYSTATION=
BITREFILL_PRODUCT_XBOX=
BITREFILL_TEST_PRODUCT=test-gift-card-code
BITREFILL_BASE_URL=https://api.bitrefill.com/v2

# ---------- What the site shows ----------
# Ticker shown in the UI, without the "$" (defaults to the one in lib/brand.ts)
TOKEN_SYMBOL=GTA6FUND
# The CA above is all the site needs: the "get the coin" link is built from it,
# and the X account (@gta6fundsol) is set in lib/brand.ts.

# ---------- Test mode (dev only — ignored in production) ----------
# Simulates a full pot and fires a draw from the browser every interval
TEST_MODE=false
TEST_DISTRIBUTE_INTERVAL_MS=10000
