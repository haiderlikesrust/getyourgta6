generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RewardStatus {
  UNCLAIMED
  CLAIMED
}

enum ClaimStatus {
  PENDING
  VERIFIED
  REFUNDED
  EXPIRED
}

model Reward {
  id              String       @id @default(cuid())
  holderWallet    String
  brand           String       @default("pending")
  amountUsd       Float
  giftCardCodeEnc String?
  status          RewardStatus @default(UNCLAIMED)
  purchaseClaimId String?      @unique
  /// "holder" = held the boost threshold at draw time, "open" = free opt-in entry
  tier            String       @default("holder")
  /// tickets this wallet had in the draw
  weight          Int          @default(1)
  /// total tickets in the draw
  poolTickets     Int          @default(0)
  /// what this prize reserved from the treasury (gift card value + buffer)
  costUsd         Float        @default(0)
  /// provider invoice opened for this prize; reused on retry so it is never paid twice
  invoiceId       String?
  invoiceAt       DateTime?
  /// signature of the on-chain payment, stored before it is broadcast
  fundingTxSig    String?
  paymentAt       DateTime?
  /// set once the payment is confirmed and the reservation is released
  fundedAt        DateTime?
  createdAt       DateTime     @default(now())
  claimedAt       DateTime?
  claims          Claim[]

  @@index([holderWallet, status])
}

model Claim {
  id                   String      @id @default(cuid())
  rewardId             String
  reward               Reward      @relation(fields: [rewardId], references: [id])
  tempPubkey           String
  tempSecretEnc        String
  claimTokenHash       String
  chosenBrand          String
  verifyAmountLamports BigInt
  status               ClaimStatus @default(PENDING)
  verifiedTxSig        String?     @unique
  refundTxSig          String?
  activeRewardKey      String?     @unique
  codeRevealedAt       DateTime?
  expiresAt            DateTime
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([rewardId, status])
}

model LedgerState {
  id                  String    @id @default("singleton")
  allocatedUsd        Float     @default(0)
  lastRunAt           DateTime?
  isProcessing        Boolean   @default(false)
  processingStartedAt DateTime?
}

/// A wallet that connected and opted in to the draw (signature verified).
model Entry {
  wallet    String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Public paper trail: fee claims, Jupiter swaps, card top-ups.
model TreasuryEvent {
  id        String   @id @default(cuid())
  kind      String
  usdValue  Float    @default(0)
  txSig     String?
  detail    String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Cross-process lease so a job never runs twice at once (two containers
/// overlap for a moment during a zero-downtime update).
model JobLock {
  name        String   @id
  lockedUntil DateTime
}

model HolderSnapshot {
  id          String   @id @default(cuid())
  takenAt     DateTime @default(now())
  holderCount Int
  json        String
}
